generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  googleId         String?   @unique
  emailVerified    DateTime?
  marketingConsent Boolean   @default(false)
  role             String    @default("USER") // USER or ADMIN
  tags             String    @default("[]")   // JSON string array e.g. '["weight-loss", "diabetes"]'
  leadData         String?   @default("{}")   // JSON string storing the 4 general survey answers
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  downloads            Download[]
  pageViews            PageView[]
  accounts             Account[]
  sessions             Session[]
  personalizedRequests PersonalizedRequest[]
  favorites            Favorite[]
}

model Content {
  id          String      @id @default(cuid())
  type        String      // RECIPE | DIET_PLAN | CHEAT_SHEET | BLOG
  title       String
  slug        String      @unique
  excerpt     String
  body        String      // Rich text JSON (Tiptap)
  coverImage  String?     // URL
  coverVideo  String?     // URL
  downloadUrl String?     // PDF URL (for cheat sheets/diet plans)

  // Recipe Metadata
  cookingTime String?
  prepTime    String?
  difficulty  String?     // Easy | Medium | Hard
  calories    Int?
  rating      Float       @default(0)
  servings    Int?

  seoTitle    String?
  seoDesc     String?
  keywords    String      @default("[]") // JSON string array
  schema      String?     // JSON-LD schema object as string
  tags        String      @default("[]") // JSON string array
  painPointQuestions String? @default("[]") // JSON string array of custom questions
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  downloads            Download[]
  personalizedRequests PersonalizedRequest[]
  favorites            Favorite[]
}

model Download {
  id        String   @id @default(cuid())
  userId    String?  // null = anonymous (first free download)
  contentId String
  ipAddress String
  userAgent String?
  isAnon    Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  content Content  @relation(fields: [contentId], references: [id])
}

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  referrer  String?
  country   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  type      String      // WELCOME | FOLLOW_UP | VERIFY | MARKETING
  status    String
  createdAt DateTime    @default(now())
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PersonalizedRequest {
  id              String   @id @default(cuid())
  userId          String
  contentId       String
  answers         String   // JSON string of all 7 answers
  generatedPrompt String   // The compiled text prompt for LLM
  generatedContent String? // The actual output generated by the AI
  status          String   @default("PENDING") // PENDING | PROCESSED | SENT
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
}

// NextAuth required tables
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}
